# ============================================================================
# VisitaFlow - configuracion local
# ============================================================================
# Copie este archivo como .env y ajuste los valores. Nada de aqui se sube a git.

# --- Servidor ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Detras de nginx/Traefik (Dokploy) debe quedar en 1 para que la bitacora
# registre la IP real del visitante y no la del proxy.
DETRAS_DE_PROXY=1
URL_PUBLICA=http://localhost:3000

# --- Base del sistema (lectura/escritura) -----------------------------------
# Es la base propia de VisitaFlow. Se crea con: npm run db:crear
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=cambie_esta_clave
DB_DATABASE=VisitaFlow
DB_ENCRYPT=0
DB_TRUST_CERT=1

# Nombre que usa docker-compose.yml para la contrasena de SQL Server.
# En el VPS, Dokploy lee esta variable del archivo .env.
#
# OJO CON LA CONTRASENA, que es el fallo que mas tiempo cuesta al desplegar:
# SQL Server la rechaza si no lleva 8 caracteres como minimo, una mayuscula, una
# minuscula, un numero y un simbolo. Si no los lleva, el contenedor de la base
# arranca y se muere en bucle SIN DECIR POR QUE, y el sintoma que se ve es que la
# aplicacion no conecta, que apunta a otro sitio.
#
# Ademas: nada de comillas simples ni dobles. Rompen el archivo .env y la linea
# de comandos donde se usan.
#
# NO reutilice la clave de su maquina de desarrollo: no suele cumplir la politica.
# Genere una con: npm run desplegar:preparar
# CLAVE_SQL=cambie_esta_clave

# --- Base de cedulas (SOLO LECTURA, sin fotografias) ------------------------
# Se puede apagar con PADRON_ACTIVO=0 para que el sistema funcione solo con
# datos escritos a mano.
PADRON_ACTIVO=1
PADRON_DB_SERVER=localhost
PADRON_DB_PORT=1433
PADRON_DB_USER=sa
PADRON_DB_PASSWORD=cambie_esta_clave
PADRON_DATABASE=PadronLigero
PADRON_TABLA=dbo.CIUDADANOS
PADRON_MS_ESPERA=15000

# Que datos del padron se pueden mostrar
IDENTIDAD_MOSTRAR_NOMBRES=1
IDENTIDAD_MOSTRAR_FECHA_NACIMIENTO=1
IDENTIDAD_MOSTRAR_SEXO=1
IDENTIDAD_MOSTRAR_MUNICIPIO=1
# Exigir que la cedula exista en el padron para poder registrar la visita
IDENTIDAD_EXIGIR_EN_PADRON=0
# Edad minima aceptada al registrar (0 = sin limite)
IDENTIDAD_EDAD_MINIMA=0

# --- Seguridad --------------------------------------------------------------
# CAMBIE ESTO en el VPS: con este secreto se firman las sesiones.
JWT_SECRET=cambie-este-secreto-en-produccion
JWT_EXPIRA=12h
# Minutos de inactividad antes de exigir la clave otra vez (0 = no exigir)
SESION_MINUTOS_INACTIVIDAD=0

# Protege las rutas de administracion del servidor de licencias.
ADMIN_TOKEN=
# En el VPS, Dokploy lee el token del archivo .env con este nombre.
# ADMIN_TOKEN ya sirve; no hace falta duplicarlo.

# --- Licencia ---------------------------------------------------------------
# Archivo .vflow que carga esta instalacion.
# Vive dentro de datos/, que en el VPS es un volumen: fuera de ahi se perderia
# en cada redespliegue y habria que volver a activar el sistema.
LICENCIA_ARCHIVO=./datos/licencia.vflow

# Carpeta base de los datos del sistema (licencia, credenciales y logos).
# En el VPS el Compose la apunta a /app/datos, que es el volumen.
# DATOS_CARPETA=./datos
LICENCIA_DIAS_AVISO=30
# Servidor de licencias: es el que permite ACTIVAR CON EL ID.
#
# En la instalación de un cliente, aquí va la dirección PÚBLICA del servidor de
# licencias del vendedor. Por ejemplo:
#
#   LICENCIA_SERVIDOR=https://licencias.su-dominio.com
#
# Si se deja vacío, el sistema igual funciona: se activa pegando el archivo
# .vflow. Es lo que hay que hacer en una instalación sin salida a Internet.
#
# Dentro del docker-compose.yml esta variable se llama LICENCIA_SERVIDOR_URL,
# para no confundirla con la dirección interna entre contenedores.
LICENCIA_SERVIDOR=
# Token que comparten el servidor de licencias y cada instalacion.\n# Se usa al RENOVAR y al avisar que se activo. Sin el, esas dos rutas quedan\n# cerradas (la activacion por ID sigue funcionando). El mismo valor va en el\n# servidor de licencias y en la instalacion de cada cliente.\n# Generelo con: npm run desplegar:preparar\nLICENCIA_TOKEN_ACTIVACION=
# Horas que se sigue operando con la ultima licencia buena si el servidor de
# licencias no responde. Pasado ese plazo, sin licencia valida, el sistema queda
# en solo lectura.
LICENCIA_HORAS_SIN_SERVIDOR=72

# Llaves del licenciamiento.
#   En LOCAL se leen de los archivos de licencias-keys/ (npm run keys:gen).
#   En el VPS van por variable de entorno, en base64, porque el archivo no se
#   sube al servidor. Solo el servidor de licencias recibe la PRIVADA.
LICENCIA_LLAVE_PUBLICA_ARCHIVO=
LICENCIA_LLAVE_PRIVADA_ARCHIVO=
# LICENCIA_LLAVE_PUBLICA_B64=
# LICENCIA_LLAVE_PRIVADA_B64=
# Tambien se aceptan los PEM completos, con los saltos de linea como \n:
# LICENCIA_LLAVE_PUBLICA_PEM=
# LICENCIA_LLAVE_PRIVADA_PEM=

# --- Archivos ---------------------------------------------------------------
ARCHIVOS_CARPETA=./datos/archivos
ARCHIVOS_MAX_LOGO_BYTES=2097152

# --- Correo (opcional, para recuperar contrasenas) --------------------------
CORREO_ACTIVO=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VisitaFlow <no-responder@visitaflow.local>

# --- Auditoria --------------------------------------------------------------
AUDITORIA_ACTIVA=1
AUDITORIA_DIAS_RETENCION=730

# Configuration reference. Variables must be supplied to the process; not auto-loaded.
DEMO_MODE=true
API_PORT=3100
ISSUER_PORT=3200
# Required for configured API: separate app and read-only registry connections.
APP_SQL_CONNECTION=
REGISTRY_SQL_CONNECTION=
API_ACCESS_TOKEN=
TENANT_ID=
INSTALLATION_ID=
LICENSE_FILE=
LICENSE_PUBLIC_KEYS_FILE=
# Issuer only. Never distribute its private key to reception installations.
ISSUER_PRIVATE_KEY_FILE=
ISSUER_ENTITLEMENTS_FILE=
ISSUER_KEY_ID=
ISSUER_ADMIN_TOKEN=
